{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "KherveDB",
  "version": "5.0.0",
  "identifier": "com.kerherve.khervedb",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:5173",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "KherveDB",
        "width": 960,
        "height": 800,
        "minWidth": 760,
        "minHeight": 600,
        "resizable": true,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "nsis"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper"
      },
      "nsis": {
        "installMode": "currentUser"
      }
    },
    "createUpdaterArtifacts": true,
    "publisher": "Gwilherm Kerherve",
    "shortDescription": "NIST XPS binding-energy database",
    "copyright": "Gwilherm Kerherve",
    "category": "Education",
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEQyQzYzNzg1QzYwQ0EwNDIKUldSQ29BekdoVGZHMG54R0JVRnNGYXgwUEhWMkJ2YjhJYmowVWMxWGRvWnFmSDYvSXZqN2JUWmMK",
      "endpoints": [
        "https://github.com/gkerherve/KherveDB/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}